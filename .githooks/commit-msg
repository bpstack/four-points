#!/bin/sh
#
# commit-msg — bloquea atribución de IA en el historial de Git.
#
# Regla de proyecto: los mensajes de commit no deben revelar que un asistente
# de IA ha intervenido. Ver "Commit Conventions" en CLAUDE.md / AGENTS.md.
#
# Este hook existe porque las plantillas por defecto de varios clientes de IA
# (Claude Code, Codex, etc.) inyectan estos footers automáticamente. La regla
# escrita no basta: se necesita una comprobación determinista.
#
# Instalación: git config core.hooksPath .githooks
# Saltar (excepcional):  git commit --no-verify

msg_file="$1"
# Ignorar líneas de comentario que git añade al editor
body=$(grep -v '^#' "$msg_file")

fail() {
  echo "" >&2
  echo "✖ commit-msg: mensaje rechazado — atribución de IA detectada" >&2
  echo "" >&2
  echo "  Coincidencia: $1" >&2
  echo "" >&2
  echo "  El historial de este repo no debe contener rastro de asistentes de IA." >&2
  echo "  Elimina la línea y vuelve a intentarlo. Ver 'Commit Conventions' en CLAUDE.md." >&2
  echo "" >&2
  exit 1
}

# Footers de co-autoría de IA
match=$(printf '%s' "$body" | grep -iEn 'co-authored-by:.*(claude|anthropic|copilot|codex|cursor|openai|gpt|gemini|opencode)' | head -1)
[ -n "$match" ] && fail "$match"

# Footers "Generated with ..."
match=$(printf '%s' "$body" | grep -iEn 'generated with|🤖|noreply@anthropic\.com|claude\.com/claude-code|generated by (claude|codex|copilot|cursor|an ai)' | head -1)
[ -n "$match" ] && fail "$match"

# Menciones en prosa
match=$(printf '%s' "$body" | grep -iEn 'ai-(assisted|generated)|with (the )?help of (claude|chatgpt|copilot)|as an ai|escrito por (claude|la ia)' | head -1)
[ -n "$match" ] && fail "$match"

exit 0
