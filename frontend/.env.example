# Example environment variables for Next.js

# ==========================================
# VARIABLES DE ENTORNO - FRONTEND
# ==========================================

# URL del Backend - Para componentes del navegador (cliente)
# El prefijo NEXT_PUBLIC_ hace que sea accesible en el browser
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL del Backend - Para API Routes (servidor)
# Sin prefijo = solo accesible en el servidor de Next.js
BACKEND_URL=http://localhost:4000

# App
NEXT_PUBLIC_APP_NAME=Four-Points

# Database (no es la que uso, la conectaré a mi mysql db)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mydb

# 🗄️ database mysql config
# =============================
DB_HOST=localhost
DB_PORT=esto lo tengo en mis pcs
DB_USER=root
DB_PASSWORD=
DB_NAME=hotel_db

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme

# JWT
JWT_SECRET=changeme

# Third-party services
STRIPE_PUBLIC_KEY=pk_test_yourkey
STRIPE_SECRET_KEY=sk_test_yourkey

SENDGRID_API_KEY=changeme
SENTRY_DSN=changeme

# Cloud storage
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_S3_BUCKET=my-bucket