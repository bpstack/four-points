# .env.local — copy and fill in. Never commit real values.

# Backend API, used by the browser and by server code
NEXT_PUBLIC_API_URL=http://localhost:4000
# (optional) Different API URL for server-side requests only
# NEXT_SERVER_API_URL=http://localhost:4000

# Hotel name printed in the footer of printed checklists (default: Hotel PMS)
# NEXT_PUBLIC_HOTEL_NAME=My Hotel

# Analytics (optional) — leave empty or unset to disable
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS=true
