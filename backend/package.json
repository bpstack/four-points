  "scripts": {
    "dev": "tsx watch index.ts",
    "dev:local": "cross-env DB_ENVIRONMENT=local tsx watch index.ts",
    "dev:aiven": "cross-env DB_ENVIRONMENT=aiven tsx watch index.ts",
    "build": "python3 -m venv scheduling-solver/venv && scheduling-solver/venv/bin/pip install --no-cache-dir -r scheduling-solver/requirements.txt",
    "start": "tsx index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:corpus": "vitest run tests/scheduling/corpus.test.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js}\"",
    "format:check": "prettier --check \"**/*.{ts,js}\""
  },
  "keywords": [],
