# .env — copy to backend/.env and fill in. Never commit real values.
# Every variable here is read by the backend code (process.env.*);
# tests/security/env-example.test.ts keeps both lists in sync.

# =============================
# Server
# =============================
PORT=4000
NODE_ENV=development
# debug | info | warn | error (default: debug in development, info in production)
LOG_LEVEL=
# Extra allowed CORS origin, on top of the ones in index.ts (optional)
FRONTEND_URL=

# =============================
# Security
# =============================
# At least 32 characters
SECRET_JWT_KEY=change-me-to-a-random-string-of-32-or-more-characters
SALT_ROUNDS=10

# =============================
# MySQL: which preset config/db.ts uses (local | aiven, default: local)
# =============================
DB_ENVIRONMENT=aiven

# Local MySQL
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=hotel_db

# Aiven MySQL (values from the Aiven console)
AIVEN_DB_HOST=
AIVEN_DB_PORT=
AIVEN_DB_USER=
AIVEN_PASSWORD=
AIVEN_DB_NAME=hotel_db

# =============================
# Cloudinary (images and invoice PDFs)
# =============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
