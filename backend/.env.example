# .env

# =============================
# 🌐 Servidor
# =============================
PORT=4000
NODE_ENV=development

# =============================
# 🔐 Seguridad
# =============================
SECRET_JWT_KEY=your-secret-jwt-key
SALT_ROUNDS=10

# =============================
# 🗄️ MySQL LOCAL
# =============================
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=tusabrasAES
LOCAL_DB_NAME=hotel_db

# =============================
# 🗄️ MySQL AIVEN
# =============================
AIVEN_DB_HOST=your-service.aivencloud.com
AIVEN_DB_PORT=23225
AIVEN_DB_USER=avnadmin
AIVEN_PASSWORD=delawebAES
AIVEN_DB_NAME=hotel_db

# =============================
# ☁️ Cloudinary (Image Upload)
# =============================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================
# 🤖 AI Integration (Schedule)
# =============================
# Enable/disable AI optimization
AI_ENABLED=true

# Claude (Anthropic) - https://console.anthropic.com/
CLAUDE_API_KEY=***REMOVED***
CLAUDE_MODEL=claude-sonnet-4-20250514

# Gemini (Google AI Studio) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (optional) - https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Ollama (local) - https://ollama.ai/
# Solo para desarrollo local - requiere Ollama instalado
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2:latest

# Groq (cloud, free tier) - https://console.groq.com/
# Muy rápido y con tier gratuito generoso
# GROQ_API_KEY=gsk_your-key-here
# GROQ_MODEL=llama-3.3-70b-versatile